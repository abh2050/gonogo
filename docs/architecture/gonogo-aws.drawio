 source="i30" target="i31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i31" target="i32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k56" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="322" width="24" height="24" as="geometry"/></mxCell><mxCell id="k57" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="322" width="24" height="24" as="geometry"/></mxCell><mxCell id="k58" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="280" width="24" height="24" as="geometry"/></mxCell><mxCell id="k59" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1012" y="240" width="24" height="24" as="geometry"/></mxCell><mxCell id="k60" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="316" width="24" height="24" as="geometry"/></mxCell><mxCell id="k61" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="690" width="24" height="24" as="geometry"/></mxCell><mxCell id="k62" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="150" width="24" height="24" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;How one question is answered&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The browser loads the app and calls the API on the same CloudFront address.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; API Gateway rejects a request with no valid Cognito token before any code runs.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The token carries exactly one role group.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The engine asks Cedar whether that role may ask, read, approve, or review.&lt;br&gt;&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; The fixed-pattern parser reads the question. (A model reader exists for messy wording; it is off in this deployment.)&lt;br&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; Seven rules read the graph through fixed SPARQL templates. The query Lambda puts only the graphs this role may read in the FROM clauses.&lt;br&gt;&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; The decision is stored with its cutoff, release, facts, and a signature, and an audit copy is locked in S3." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="310" height="640" as="geometry"/></mxCell><mxCell id="b64" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1420" y="790" width="250" height="102" as="geometry"/></mxCell><mxCell id="x65" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1432" y="796" width="200" height="20" as="geometry"/></mxCell><mxCell id="l66" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1434" y="828" as="sourcePoint"/><mxPoint x="1484" y="828" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x67" value="Request and data path" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1494" y="819" width="170" height="20" as="geometry"/></mxCell><mxCell id="l68" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1434" y="852" as="sourcePoint"/><mxPoint x="1484" y="852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x69" value="Other data flow" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1494" y="843" width="170" height="20" as="geometry"/></mxCell><mxCell id="l70" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1434" y="876" as="sourcePoint"/><mxPoint x="1484" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x71" value="Policy, token, or key" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1494" y="867" width="170" height="20" as="geometry"/></mxCell><mxCell id="x72" value="Only Neptune bills while idle. scripts/teardown.py removes everything but the budget." style="text;html=1;fontSize=12;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="920" width="310" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Request path" id="page-2"><mxGraphModel dx="1640" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="A clearance question, step by step" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1580" height="36" as="geometry"/></mxCell><mxCell id="s2" value="One request from a signed-in licensing manager to a stored decision. Time runs down the page. Every call that crosses a service boundary is signed or carries the user's token." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="44" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;Licensing manager&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="l4" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#C6CBD0;strokeWidth=1.25;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="222" as="sourcePoint"/><mxPoint x="108" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="i5" value="&lt;b&gt;CloudFront&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="258" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="l6" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#C6CBD0;strokeWidth=1.25;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="286" y="222" as="sourcePoint"/><mxPoint x="286" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="i7" value="&lt;b&gt;API Gateway&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="436" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="l8" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#C6CBD0;strokeWidth=1.25;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="464" y="222" as="sourcePoint"/><mxPoint x="464" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="i9" value="&lt;b&gt;Cognito&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="614" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="l10" value="" style="html=1;endArrow=none;endFill=1;strokeColor