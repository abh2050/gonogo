 height="48" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;Idle cost:&lt;/b&gt; free while idle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="665" y="630" width="260" height="44" as="geometry"/></mxCell><mxCell id="z21" value="gonogo-eval&lt;br&gt;&lt;span style='font-weight:normal'&gt;Benchmark search&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F7F4;strokeColor=#01A88D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="290" height="560" as="geometry"/></mxCell><mxCell id="i22" value="Knowledge Base" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="990" y="210" width="48" height="48" as="geometry"/></mxCell><mxCell id="i23" value="S3 Vectors" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="48" height="48" as="geometry"/></mxCell><mxCell id="i24" value="S3 corpus" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4