<mxfile host="app.diagrams.net"><diagram name="1. System overview" id="page-1"><mxGraphModel dx="1760" dy="1160" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="GoNoGo on AWS: the whole system" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1700" height="36" as="geometry"/></mxCell><mxCell id="s2" value="Region us-east-2, deployed with the AWS CDK in Python. Numbers follow one clearance question from the browser to a stored, signed decision. Seven rules decide every verdict; no model decides one." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1700" height="44" as="geometry"/></mxCell><mxCell id="z3" value="Who" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="140" height="420" as="geometry"/></mxCell><mxCell id="i4" value="Licensing manager,&lt;br&gt;steward, counsel,&lt;br&gt;and three more roles" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="z5" value="Edge" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4EFFF;strokeColor=#8C4FFF;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle