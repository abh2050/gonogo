align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1532" y="222" as="sourcePoint"/><mxPoint x="1532" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l21" value="1. sign in: user name and password" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="250" as="sourcePoint"/><mxPoint x="642" y="250" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l22" value="2. ID token with one role group" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="302" as="sourcePoint"/><mxPoint x="108" y="302" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l23" value="3. POST /api/decide, Authorization: token" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="354" as="sourcePoint"/><mxPoint x="286" y="354" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l24" value="4. forward on the same origin" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="286" y="406" as="sourcePoint"/><mxPoint x="464" y="406" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l25" value="5. verify the token's signature" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="464" y="458" as="sourcePoint"/><mxPoint x="642" y="458" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l26" value="6. invoke with verified claims" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="464" y="510" as="sourcePoint"/><mxPoint x="820" y="510" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l27" value="7. may this role AskClearance?" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="562" as="sourcePoint"/><mxPoint x="998" y="562" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l28" value="8. allow" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="998" y="614" as="sourcePoint"/><mxPoint x="820" y="614" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="b29" value="9. parse: patent, license type, field, territory, dates" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="828" y="654" width="260" height="26" as="geometry"/></mxCell><mxCell id="l30" value="10. fixed SPARQL templates, FROM the allowed graphs only" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="718" as="sourcePoint"/><mxPoint x="1176" y="718" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l31" value="11. facts with recording times and source clauses" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1176" y="770" as="sourcePoint"/><mxPoint x="820" y="770" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="b32" value="12. seven rules, then the versioned combiner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="828" y="810" width="260" height="26" as="geometry"/></mxCell><mxCell id="l33" value="13. store the decision row" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="874" as="sourcePoint"/><mxPoint x="1354" y="874" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l34" value="14. lock a signed copy (Object Lock)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="926" as="sourcePoint"/><mxPoint x="1532" y="926" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="l35" value="15. verdict, the rule that decided, the clauses behind it" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="978" as="sourcePoint"/><mxPoint x="108" y="978" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n36" value="&lt;b&gt;What this path guarantees&lt;/b&gt;&lt;br&gt;• No code runs for a request without a valid token.&lt;br&gt;• The role comes from the token, never from the request body.&lt;br&gt;• A rule can only read graphs the role may read; the candidate graph is never read by a rule.&lt;br&gt;• The same request at the same cutoff gives the same signature." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="760" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Ingestion workflow" id="page-3"><mxGraphModel dx="1700" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Ingesting a license agreement" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1640" height="36" as="geometry"/></mxCell><mxCell id="s2" value="Step Functions state machine gonogo-ingest. A PDF becomes a proposed grant, waits for a person, and only then reaches the graph. The text is evidence: nothing in it is ever followed as an instruction." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1640" height="44" as="geometry"/></mxCell><mxCell id="i3" value="S3 inbox&lt;br&gt;KMS encrypted" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="56" height="56" as="geometry"/></mxCell><mxCell id="i4" value="Start Lambda&lt;br&gt;one run per PDF" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="170" y="240" width="56" height="56" as="geometry"/></mxCell><mxCell id="z5" value="State machine: gonogo-ingest (Step Functions)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEEF5;strokeColor=#E7157B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="1370" height="450" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;ReadWithTextract&lt;/b&gt;&lt;br&gt;OCR Lambda" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F7F4;strokeColor=#01A88D;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="150" height="60" as="geometry"/></mxCell><mxCell id="i7" value="Textract" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.textract;" vertex="1" parent="1"><mxGeometry x="378" y="380" width="56" height="56" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;ExtractGrant&lt;/b&gt;&lt;br&gt;fixed patterns, no model" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;CheckShapes&lt;/b&gt;&lt;br&gt;propose on a copy, SHACL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="d10" value="Conforms?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#C27A05;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="935" y="235" width="110" height="70" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Invalid&lt;/b&gt;&lt;br&gt;a person reads the PDF" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBE3E1;strokeColor=#CF3A34;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="925" y="480" width="130" height="56" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;AwaitApproval&lt;/b&gt;&lt;br&gt;waitForTaskToken, up to 7 days" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECE6FB;strokeColor=#6D44CC;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="240" width="190" height="60" as="geometry"/></mxCell><mxCell id="i13" value="Pending table&lt;br&gt;token + proposal" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1062" y="390" width="48" height="48" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;WriteToGraph&lt;/b&gt;&lt;br&gt;Apply Lambda, in the VPC" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F8EA;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="160" width="170" height="56" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;RerunRequests&lt;/b&gt;&lt;br&gt;verdicts before and after" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F8EA;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="320" width="170" height="56" as="geometry"/></mxCell><mxCell id="i16" value="Neptune" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.neptune;" vertex="1" parent="1"><mxGeometry x="1580" y="240" width="56" height="56" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;NotApproved&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBE3E1;strokeColor=#CF3A34;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="470" width="170" height="40" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i4" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b9" target="d10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="i7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d10" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="park" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="i13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b14" target="b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1251" y="490"/></Array></mxGeometry></mxCell><mxCell id="e30" value="INSERT DATA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="i16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="two cutoffs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="i16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i32" value="Steward" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="i33" value="POST /ingest/decide&lt;br&gt;Cognito token" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="1180" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="i34" value="Counsel" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1360" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="e35" value="approve or reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i32" target="i33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="second review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i34" target="i33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="SendTaskSuccess" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="i33" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="&lt;b&gt;Cedar decides who may approve.&lt;/b&gt; One steward is enough unless the approval conflicts with an approved fact or would raise a verdict to GO. Then the decision answers 202, the run keeps waiting, and counsel's second review releases it. Nobody, including the pipeline, approves what they proposed." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="610" width="230" height="200" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;What extraction refuses&lt;/b&gt;&lt;br&gt;• a field of use that is not a concept in the field scheme&lt;br&gt;• a licensee that is not one known licensee&lt;br&gt;• an agreement already on record&lt;br&gt;&lt;br&gt;&lt;b&gt;What it never copies&lt;/b&gt;&lt;br&gt;• the royalty article (royalty terms live only in the royalty graph)&lt;br&gt;• an unrecognized article, which is kept as text and shown to the steward" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="420" height="180" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;On the synthetic agreements&lt;/b&gt;&lt;br&gt;101 of 120 read exactly as written, 19 refused for a person, none read wrong. A planted instruction to mark every request GO changes no verdict." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="490" y="620" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Security and network" id="page-4"><mxGraphModel dx="1700" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Security and network boundaries" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1640" height="36" as="geometry"/></mxCell><mxCell id="s2" value="What can reach what. The graph sits in a VPC with no route to the internet; only two functions may write to it, and neither has an API route an outside caller can use to send it arbitrary data." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1640" height="44" as="geometry"/></mxCell><mxCell id="g3" value="AWS account (organization member)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1300" height="900" as="geometry"/></mxCell><mxCell id="g4" value="us-east-2 (Ohio): the only region the code allows" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="1240" height="840" as="geometry"/></mxCell><mxCell id="z5" value="Identity" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEEEF;strokeColor=#DD344C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="90" y="210" width="300" height="330" as="geometry"/></mxCell><mxCell id="i6" value="Cognito user pool&lt;br&gt;admin-created users,&lt;br&gt;one group per user" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="130" y="260" width="56" height="56" as="geometry"/></mxCell><mxCell id="i7" value="API Gateway&lt;br&gt;Cognito authorizer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="270" y="260" width="56" height="56" as="geometry"/></mxCell><mxCell id="i8" value="Verified Permissions&lt;br&gt;strict schema" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.verified_permissions;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="z9" value="Outside the VPC: they call AWS APIs, so they need no NAT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="520" height="330" as="geometry"/></mxCell><mxCell id="i10" value="Engine Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="460" y="262" width="56" height="56" as="geometry"/></mxCell><mxCell id="i11" value="Ingest Lambdas" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="600" y="262" width="56" height="56" as="geometry"/></mxCell><mxCell id="i12" value="Textract" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.textract;" vertex="1" parent="1"><mxGeometry x="740" y="262" width="56" height="56" as="geometry"/></mxCell><mxCell id="i13" value="Bedrock" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="860" y="262" width="56" height="56" as="geometry"/></mxCell><mxCell id="i14" value="DynamoDB&lt;br&gt;KMS encrypted" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="i15" value="S3 audit, inbox&lt;br&gt;KMS, Object Lock" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="i16" value="KMS key&lt;br&gt;encrypts tables,&lt;br&gt;buckets, Neptune" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="g17" value="VPC: two isolated subnets, no NAT, no internet gateway, no interface endpoints" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="1180" height="400" as="geometry"/></mxCell><mxCell id="g18" value="Security group: port 8182 from members of this group only" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="130" y="640" width="820" height="310" as="geometry"/></mxCell><mxCell id="i19" value="Query Lambda&lt;br&gt;ReadDataViaQuery" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="170" y="720" width="48" height="48" as="geometry"/></mxCell><mxCell id="i20" value="Loader Lambda&lt;br&gt;read, write, delete" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="370" y="720" width="48" height="48" as="geometry"/></mxCell><mxCell id="i21" value="Apply Lambda&lt;br&gt;read, write" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="570" y="720" width="48" height="48" as="geometry"/></mxCell><mxCell id="i22" value="Rerun Lambda&lt;br&gt;read only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="48" height="48" as="geometry"/></mxCell><mxCell id="i23" value="Neptune Serverless&lt;br&gt;IAM auth, KMS at rest" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.neptune;" vertex="1" parent="1"><mxGeometry x="460" y="860" width="56" height="56" as="geometry"/></mxCell><mxCell id="i24" value="S3 gateway endpoint&lt;br&gt;(free)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1020" y="720" width="56" height="56" as="geometry"/></mxCell><mxCell id="i25" value="S3 graph files" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1150" y="720" width="56" height="56" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="i7" target="i6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="verified claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i7" target="i10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="same Cedar text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i10" target="i8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="312"/><mxPoint x="440" y="448"/></Array></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i11" target="i12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i10" target="i19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="488" y="560"/><mxPoint x="76" y="560"/><mxPoint x="76" y="744"/></Array></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i19" target="i23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i20" target="i23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i21" target="i23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i22" target="i23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="graph files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i20" target="i24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="394" y="690"/><mxPoint x="1048" y="690"/></Array></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i24" target="i25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="&lt;b&gt;Who may touch Neptune&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='0' cellpadding='3'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Function&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Read&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Write&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;API route&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Query&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;/query, /decide&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Loader&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Apply&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;none (state machine)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rerun&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;none (state machine)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Engine&lt;/td&gt;&lt;td colspan='3'&gt;no network path; reads a bundled snapshot&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="320" height="230" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Checked on every build&lt;/b&gt; (tests/infra)&lt;br&gt;• no NAT gateway, internet gateway, or interface endpoint&lt;br&gt;• exactly two IAM policies grant WriteDataViaQuery&lt;br&gt;• every API method needs a Cognito token&lt;br&gt;• the inbox and audit buckets block public access and use KMS&lt;br&gt;• nothing outside us-east-2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="320" height="160" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Checked against the live stack&lt;/b&gt; (infra/evidence.py)&lt;br&gt;Verified Permissions gave the same answer as in-process Cedar on 126 of 126 questions. A request with no token got 401, and a role that may not read a graph got 403 before any query ran." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1360" y="570" width="320" height="130" as="geometry"/></mxCell><mxCell id="b40" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1360" y="730" width="250" height="102" as="geometry"/></mxCell><mxCell id="x41" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1372" y="736" width="200" height="20" as="geometry"/></mxCell><mxCell id="l42" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1374" y="768" as="sourcePoint"/><mxPoint x="1424" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x43" value="Call or data path" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1434" y="759" width="170" height="20" as="geometry"/></mxCell><mxCell id="l44" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1374" y="792" as="sourcePoint"/><mxPoint x="1424" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x45" value="Token, policy, or key" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1434" y="783" width="170" height="20" as="geometry"/></mxCell><mxCell id="l46" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1374" y="816" as="sourcePoint"/><mxPoint x="1424" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x47" value="Neptune access (IAM)" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1434" y="807" width="170" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. Data and access" id="page-5"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Four named graphs, six roles" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1440" height="36" as="geometry"/></mxCell><mxCell id="s2" value="The graph is split into named graphs, and Cedar decides which a role may query. The query service writes only the allowed graphs into the FROM clauses, so a forbidden graph is never even searched. The grid below is read from the Cedar policies when the diagram is built." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1440" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Release graph&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;ontology, vocabularies, shapes&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E6F2F8;strokeColor=#147EBA;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="190" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Approved graph&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;facts a person or policy approved&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F2F8EA;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="190" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Candidate graph&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;proposals; no rule reads it&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="140" width="190" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Royalty graph&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;confidential royalty terms&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#FBE3E1;strokeColor=#CF3A34;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="190" height="110" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Other access&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Cedar actions beyond graph reads&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="160" width="250" height="70" as="geometry"/></mxCell><mxCell id="b8" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E9EBED;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="1460" height="76" as="geometry"/></mxCell><mxCell id="i9