<mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="The five CDK stacks, and what each costs while idle" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="36" as="geometry"/></mxCell><mxCell id="s2" value="Everything is deployed for a session, checked, and torn down by scripts/teardown.py. The public demo on Vercel keeps working with no AWS account. Neptune is the one resource that bills by the hour." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1540" height="44" as="geometry"/></mxCell><mxCell id="z3" value="gonogo-core&lt;br&gt;&lt;span style='font-weight:normal'&gt;Identity, keys, storage, policy&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEEEF;strokeColor=#DD344C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="290" height="560" as="geometry"/></mxCell><mxCell id="i4" value="Cognito" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="48" height="48" as="geometry"/></mxCell><mxCell id="i5" value="Verified Permissions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.verified_permissions;" vertex="1" parent="1"><mxGeom