40" as="geometry"/></mxCell><mxCell id="i24" value="Haiku fills a form only&lt;br&gt;when the parser misses a part" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="380" y="775" width="56" height="56" as="geometry"/></mxCell><mxCell id="b25" value="Every value must name&lt;br&gt;a concept the graph holds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="780" width="190" height="70" as="geometry"/></mxCell><mxCell id="b26" value="Seven rules +&lt;br&gt;versioned combiner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="170" height="70" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i24" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.75;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b25" target="b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.25;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entry