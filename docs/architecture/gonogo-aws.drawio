="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="44" y="714" width="48" height="48" as="geometry"/></mxCell><mxCell id="x50" value="&lt;b&gt;Auditor&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="104" y="722" width="260" height="24" as="geometry"/></mxCell><mxCell id="b51" value="no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#E9EBED;fontSize=12;fontColor=#879196;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="718" width="150" height="38" as="geometry"/></mxCell><mxCell id="b52" value="no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#E9EBED;fontSize=12;fontColor=#879196;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="718" width="150" height="38" as="geometry"/></mxCell><mxCell id="b53" value="no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#E9EBED;fontSize=12;fontColor=#879196;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="718" width="150" height="38" as="geometry"/></mxCell><mxCell id="b54" value="no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#E9EBED;fontSize=12;fontColor=#879196;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="718" width="150" height="38" as="geometry"/></mxCell><mxCell id="x55" value="views and reruns decisions, reads release history, no graph" style="text;html=1;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1234" y="714" width="250" height="50" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;Rules read release and approved only.&lt;/b&gt; A proposal changes no verdict until a person approves it, because the candidate graph is outside every rule's FROM clause.&lt;br&gt;&lt;br&gt;&lt;b&gt;Royalty terms never leave their graph.&lt;/b&gt; Only counsel may query them. The benchmark corpus, the public demo snapshot, and the ingestion workflow all exclude them, and a test checks each." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="760" height="120" as="geometry"/></mxCell><mxCell id="i57" value="Neptune holds all four graphs. Each query names its graphs with FROM; the query service refuses GRAPH, SERVICE, and updates." style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.neptune;" vertex="1" parent="1"><mxGeometry x="820" y="820" width="48" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6. Benchmark" id="page-6"><mxGraphModel dx="1640" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="How the benchmark answers 200 questions four ways" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1580" height="36" as="geometry"/></mxCell><mxCell id="s2" value="The same questions and the same facts go to every answerer; only the method differs. The right answers were fixed by hand when each case was planted, never by the rule engine. Model: Claude Haiku 4.5 on Bedrock, temperature 0." style="text;html=1;fontSize=14;fontColor=#545B64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="44" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Golden set&lt;/b&gt;&lt;br&gt;45 planted cases × 4 wordings&lt;br&gt;+ 20 unanswerable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="z4" value="A. Vector RAG" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F7F4;strokeColor=#01A88D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="900" height="180" as="geometry"/></mxCell><mxCell id="z5" value="B. Graph agent" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEEF5;strokeColor=#E7157B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="900" height="180" as="geometry"/></mxCell><mxCell id="z6" value="C. Rules only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="900" height="180" as="geometry"/></mxCell><mxCell id="z7" value="C+. Rules + model reader" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F2F8EA;strokeColor=#7AA116;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#7AA116;" v