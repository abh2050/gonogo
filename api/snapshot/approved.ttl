<https://w3id.org/gonogo/id/patent/LAR-18016-1> a gng:Patent ;
    dcterms:identifier "LAR-18016-1" ;
    dcterms:title "Wireless Temperature Sensor Having No Electrical Connections and Sensing Method For Use Therewith" ;
    gng:applicationSerial "13029426" ;
    gng:caseNumber "LAR-18016-1" ;
    gng:center <https://w3id.org/gonogo/center/LaRC> ;
