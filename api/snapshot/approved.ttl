<https://w3id.org/gonogo/id/patent/LEW-18605-3> a gng:Patent ;
    dcterms:identifier "LEW-18605-3" ;
    dcterms:title "Dual-Mode Hybrid-Engine (DMH-Engine): A Next-Generation Electric Propulsion Thruster" ;
    gng:applicationSerial "14152125" ;
