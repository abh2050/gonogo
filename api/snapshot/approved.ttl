<https://w3id.org/gonogo/id/patent/LEW-18605-1> a gng:Patent ;
    dcterms:identifier "LEW-18605-1" ;
    dcterms:title "Dual-Mode Hybrid-Engine (DMH-Engine): A Next-Generation Electric Propulsion Thruster" ;
    gng:applicationSerial "12894565" ;
