gng:FilingRecord a owl:Class ;
    rdfs:label "Filing record"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:FilingRecord ;
    skos:definition "The filing date of a patent application, used when no registry supplies an expiration date. A rule that uses it must label the resulting expiration as derived."@en ;
    gng:readByRule "R1" .

gng:RegistryRecord a owl:Class ;
    rdfs:label "Registry record"@en ;
    rdfs:subClassOf prov:Entity,
        gng:RegistryRecord,
        gng:SourceDocument ;
    skos:definition "A record from a patent registry or dataset, such as a USPTO file wrapper or the NASA Patents snapshot."@en .

gng:SyntheticGeneration a owl:Class ;
    rdfs:label "Synthetic generation"@en ;
    rdfs:subClassOf prov:Activity,
        gng:FactGeneration,
        gng:SyntheticGeneration ;
    skos:definition "A run of the seeded synthetic generator. Every fact it produces is synthetic, and the prov:wasGeneratedBy link to this activity is the label that says so."@en ;
    gng:modelingDecision "MD8" .

gng:fieldOfUse a owl:ObjectProperty ;
    rdfs:label "field of use"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:FieldOfUse ;
    rdfs:subPropertyOf gng:coversField ;
    skos:definition "The field that the grant names. A notice may name none."@en ;
    gng:readByRule "R2" .

gng:territory a owl:ObjectProperty ;
    rdfs:label "territory"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:Territory ;
    rdfs:subPropertyOf gng:coversTerritory ;
    skos:definition "The territory that the grant names. A notice may name none."@en ;
    gng:readByRule "R2" .

prov:SoftwareAgent a owl:Class ;
    rdfs:subClassOf prov:Agent,
        prov:SoftwareAgent .

gng:ApprovalPolicy a owl:Class ;
    rdfs:label "Approval policy"@en ;
    rdfs:subClassOf prov:Agent,
        gng:ApprovalPolicy ;
    skos:definition "A standing approval that stands in for a person. The bulk-load policy approves public system-of-record data. It never approves a fact that a language model extracted."@en .

gng:CoOwner a owl:Class ;
    rdfs:label "Co-owner"@en ;
    rdfs:subClassOf schema:Organization,
        gng:CoOwner ;
    skos:definition "An organization, other than NASA, that the USPTO assignment records or an ownership record name as an owner of a patent."@en ;
    gng:readByRule "R6" .

gng:Extraction a owl:Class ;
    rdfs:label "Extraction"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Extraction,
        gng:FactGeneration ;
    skos:definition "A run that read candidate facts out of document text. A language model or a deterministic extractor can perform it. A steward must approve its facts before they affect a verdict."@en .

gng:RestrictedExport a owl:Class ;
    rdfs:label "Restricted export classification"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:ExportClassification,
        gng:RestrictedExport ;
    owl:disjointWith gng:UnrestrictedExport ;
    skos:definition "Export controls apply. The classification lists the territories that a licensee may sit in."@en ;
    gng:readByRule "R5" .

gng:UnrestrictedExport a owl:Class ;
    rdfs:label "Unrestricted export classification"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:ExportClassification,
        gng:UnrestrictedExport ;
    skos:definition "No export controls apply."@en ;
    gng:readByRule "R5" .

