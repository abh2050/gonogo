    skos:narrower field:emissions-monitoring,
        field:remediation ;
    skos:narrowerTransitive field:emissions-monitoring,
        field:remediation ;
    skos:notation "04" ;
    skos:prefLabel "Environment"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:information-technology-and-software a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Information Technology and Software."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:cybersecurity,
        field:data-analytics ;
    skos:narrowerTransitive field:cybersecurity,
        field:data-analytics ;
    skos:notation "06" ;
    skos:prefLabel "Information Technology and Software"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:instrumentation a skos:Concept,
