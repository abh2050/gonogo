@prefix center: <https://w3id.org/gonogo/center/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix excl: <https://w3id.org/gonogo/exclusivity/> .
@prefix field: <https://w3id.org/gonogo/field/> .
@prefix gng: <https://w3id.org/gonogo/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix state: <https://w3id.org/gonogo/legal-state/> .
@prefix territory: <https://w3id.org/gonogo/territory/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dct:created a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

dct:identifier a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

dct:title a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:broader a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:broaderTransitive ;
    owl:inverseOf skos:narrower .

skos:definition a owl:AnnotationProperty .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:topConceptOf .

skos:notation a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

skos:prefLabel a owl:AnnotationProperty .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:used a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

schema:legalName a owl:DatatypeProperty ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string .

schema:url a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI .

center:AFRC a gng:NASACenter ;
    rdfs:label "NASA Armstrong Flight Research Center" ;
    gng:centerCode "AFRC" .

center:ARC a gng:NASACenter ;
    rdfs:label "NASA Ames Research Center" ;
    gng:centerCode "ARC" .

center:GRC a gng:NASACenter ;
    rdfs:label "NASA Glenn Research Center" ;
    gng:centerCode "GRC" .

center:GSFC a gng:NASACenter ;
    rdfs:label "NASA Goddard Space Flight Center" ;
    gng:centerCode "GSFC" .

center:HQ a gng:NASACenter ;
    rdfs:label "NASA Headquarters" ;
    gng:centerCode "HQ" .

center:JPL a gng:NASACenter ;
    rdfs:label "NASA Jet Propulsion Laboratory" ;
    gng:centerCode "JPL" .

center:JSC a gng:NASACenter ;
    rdfs:label "NASA Johnson Space Center" ;
    gng:centerCode "JSC" .

center:KSC a gng:NASACenter ;
    rdfs:label "NASA Kennedy Space Center" ;
    gng:centerCode "KSC" .

center:LaRC a gng:NASACenter ;
    rdfs:label "NASA Langley Research Center" ;
    gng:centerCode "LaRC" .

center:MSFC a gng:NASACenter ;
    rdfs:label "NASA Marshall Space Flight Center" ;
    gng:centerCode "MSFC" .

center:SSC a gng:NASACenter ;
    rdfs:label "NASA Stennis Space Center" ;
    gng:centerCode "SSC" .

<https://w3id.org/gonogo/ontology> a owl:Ontology ;
    dct:description "Vocabulary for patent license clearance. A Grant relates a patent, a licensee, a field of use, a territory, a term, and an exclusivity type. Every fact is bitemporal and carries provenance. Fields of use and territories are SKOS concepts, and a broader concept means wider rights coverage."@en ;
    dct:title "GoNoGo ontology"@en ;
    rdfs:comment "Under the open world assumption, a missing fact means unknown. The rule engine, not the reasoner, turns unknown into the verdict NO DATA."@en ;
    owl:versionIRI <https://w3id.org/gonogo/ontology/0.1.0> ;
    owl:versionInfo "0.1.0" .

gng:aboutGrant a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "about grant"@en ;
    rdfs:domain gng:FieldOfUseAssignment ;
    rdfs:range gng:ProposedGrant ;
    skos:definition "The proposed grant that a field of use assignment describes."@en ;
    gng:modelingDecision "MD14" .

gng:actionReason a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "action reason"@en ;
    rdfs:domain gng:Action ;
    rdfs:range xsd:string ;
    skos:definition "The reason that the person who performed the action gave for it."@en ;
    gng:modelingDecision "MD12" .

gng:announcedIn a owl:ObjectProperty ;
    rdfs:label "announced in"@en ;
    rdfs:domain gng:ProposedGrant ;
    rdfs:range gng:LicenseNotice ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The notice that announces a proposed grant."@en ;
    gng:readByRule "R4" .

gng:applicationSerial a owl:DatatypeProperty ;
    rdfs:label "application serial number"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range xsd:string ;
    skos:definition "The application serial number as digits, for example 13033085."@en .

gng:approvedBy a owl:ObjectProperty ;
    rdfs:label "approved by"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    skos:definition "The steward, or the standing approval policy, that approved the fact."@en ;
    gng:modelingDecision "MD8" .

gng:assignsField a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assigns field"@en ;
    rdfs:domain gng:FieldOfUseAssignment ;
    rdfs:range gng:FieldOfUse ;
    skos:definition "The field of use that an assignment gives to a proposed grant. It is separate from gng:fieldOfUse, which belongs to the grant itself, so an approved assignment never edits a grant."@en ;
    gng:modelingDecision "MD14" .

gng:caseNumber a owl:DatatypeProperty ;
    rdfs:label "NASA case number"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range xsd:string ;
    skos:definition "The NASA case number, for example LAR-18232-1. A divisional or continuation keeps its suffix."@en .

gng:center a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "center"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range gng:NASACenter ;
    skos:definition "The NASA center that manages the patent."@en .

gng:centerCode a owl:DatatypeProperty ;
    rdfs:label "center code"@en ;
    rdfs:domain gng:NASACenter ;
    rdfs:range xsd:string ;
    skos:definition "The short center code, for example LaRC."@en .

gng:clauseKind a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "clause kind"@en ;
    rdfs:domain gng:Clause ;
    rdfs:range xsd:string ;
    skos:definition "What the clause states, for example grant, field, territory, term, or exclusivity."@en .

gng:coExclusiveCap a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "co-exclusive cap"@en ;
    rdfs:domain gng:ExecutedGrant ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "The largest number of co-exclusive licensees the agreement allows. Absent means no cap is recorded."@en ;
    gng:readByRule "R3" .

gng:coOwner a owl:ObjectProperty ;
    rdfs:label "co-owner"@en ;
    rdfs:domain gng:OwnershipRecord ;
    rdfs:range gng:CoOwner ;
    skos:definition "A co-owner that an ownership record lists."@en ;
    gng:readByRule "R6" .

gng:coOwnerListIsComplete a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "co-owner list is complete"@en ;
    rdfs:comment "This boolean turns 'no co-owners are listed' into either a real negative fact (complete, with an empty list) or an unknown (incomplete). OWL alone cannot make that distinction, because OWL treats a missing statement as unknown."@en ;
    rdfs:domain gng:OwnershipRecord ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the record asserts that its co-owner list is exhaustive. False means the record knows only some co-owners."@en ;
    gng:modelingDecision "MD5",
        "MD6" ;
    gng:readByRule "R6" .

gng:consentBy a owl:ObjectProperty ;
    rdfs:label "consent by"@en ;
    rdfs:domain gng:ConsentRecord ;
    rdfs:range gng:CoOwner ;
    skos:definition "The co-owner who gave consent."@en ;
    gng:readByRule "R6" .

gng:consentScope a owl:DatatypeProperty ;
    rdfs:label "consent scope"@en ;
    rdfs:domain gng:ConsentRecord ;
    rdfs:range xsd:string ;
    skos:definition "What the co-owner consented to, in words."@en .

gng:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code"@en ;
    rdfs:domain schema:Organization ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "[A-Z]{2}" ] ) ] ;
    skos:definition "The ISO 3166-1 alpha-2 code of the organization's country."@en ;
    gng:readByRule "R5" .

gng:executedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "executed on"@en ;
    rdfs:domain gng:ExecutedGrant ;
    rdfs:range xsd:date ;
    skos:definition "The date both parties signed the agreement."@en .

gng:executedUnder a owl:ObjectProperty ;
    rdfs:label "executed under"@en ;
    rdfs:domain gng:ExecutedGrant ;
    rdfs:range gng:LicenseAgreement ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The agreement that creates an executed grant."@en .

gng:expirationBasis a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "expiration basis"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:string ;
    skos:definition "How the expiration date was found."@en ;
    gng:readByRule "R1" .

gng:expirationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:date ;
    skos:definition "The date the patent expires or expired, according to the registry or the computation named in expirationBasis."@en ;
    gng:readByRule "R1" .

gng:expirationIsDerived a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "expiration is derived"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the date was computed from other dates, for example filing date plus 20 years. A derived date appears on the verdict card with that label."@en ;
    gng:readByRule "R1" .

gng:extractionModel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "extraction model"@en ;
    rdfs:domain gng:Extraction ;
    rdfs:range xsd:string ;
    skos:definition "The identifier of the model or extractor that read the facts out of text."@en ;
    gng:modelingDecision "MD8" .

gng:fieldOfUseStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "field of use status"@en ;
    rdfs:comment "Most notices state no field. The model keeps that fact explicit, so a rule can return UNKNOWN instead of guessing."@en ;
    rdfs:domain gng:ProposedGrant ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( "stated" "limited_unspecified" "not_mentioned" ) ] ;
    skos:definition "Whether the notice states a field (stated), says only that fields may be limited (limited_unspecified), or says nothing (not_mentioned)."@en .

gng:fieldOfUseText a owl:DatatypeProperty ;
    rdfs:label "field of use text"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range xsd:string ;
    skos:definition "The field of use as the document words it, before any mapping to a concept."@en .

gng:filingDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "filing date"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range xsd:date ;
    skos:definition "The date the application was filed."@en ;
    gng:readByRule "R1" .

gng:fullText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "full text"@en ;
    rdfs:domain gng:SourceDocument ;
    rdfs:range xsd:string ;
    skos:definition "The cleaned document text. Clause spans index this text by character offset."@en ;
    gng:modelingDecision "MD7" .

gng:generatorSeed a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "generator seed"@en ;
    rdfs:domain gng:SyntheticGeneration ;
    rdfs:range xsd:integer ;
    skos:definition "The seed that makes a generator run reproducible."@en .

gng:grantDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grant date"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:date ;
    skos:definition "The date the patent issued."@en .

gng:hasTerminalDisclaimer a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has terminal disclaimer"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the prosecution history shows a terminal disclaimer. A disclaimer can shorten the term below the computed date, so a rule should treat the expiration as an upper bound."@en .

gng:inDocument a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in document"@en ;
    rdfs:domain gng:Clause ;
    rdfs:range gng:SourceDocument ;
    skos:definition "The document that holds the clause."@en .

gng:iso3166Alpha2 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ISO 3166-1 alpha-2 code"@en ;
    rdfs:domain gng:Territory ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "[A-Z]{2}" ] ) ] ;
    skos:definition "The two-letter country code. Regions have none."@en ;
    gng:readByRule "R5" .

gng:lapseDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lapse date"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:date ;
    skos:definition "The date the registry recorded an expiry for unpaid maintenance fees."@en ;
    gng:readByRule "R1" .

gng:legalState a owl:ObjectProperty ;
    rdfs:label "legal state"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range gng:LegalState ;
    skos:definition "The legal state that a registry reports."@en ;
    gng:readByRule "R1" .

gng:licenseeNameAsWritten a owl:DatatypeProperty ;
    rdfs:label "licensee name as written"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range xsd:string ;
    skos:definition "The licensee's name exactly as the source document spells it. Entity resolution compares this string with the names of licensee nodes."@en ;
    gng:modelingDecision "MD9" .

gng:linksParty a owl:ObjectProperty ;
    rdfs:label "links party"@en ;
    rdfs:domain gng:IdentityLink ;
    rdfs:range schema:Organization ;
    skos:definition "A party that an identity link says is the same organization as another party. An identity link names exactly two."@en ;
    gng:readByRule "R4" .

gng:matchMethod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "match method"@en ;
    rdfs:domain gng:IdentityLink ;
    rdfs:range xsd:string ;
    skos:definition "The resolver and version that proposed the link."@en .

gng:matchScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "match score"@en ;
    rdfs:domain gng:IdentityLink ;
    rdfs:range xsd:decimal ;
    skos:definition "The resolver's similarity score for the two names, from 0 to 1."@en .

gng:minimumAnnualRoyaltyUSD a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "minimum annual royalty (USD)"@en ;
    rdfs:domain gng:RoyaltyTerm ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The smallest royalty the licensee pays in a year, in U.S. dollars."@en .

gng:modelingDecision a owl:AnnotationProperty ;
    rdfs:label "modeling decision"@en ;
    skos:definition "Names the entry in docs/modeling-decisions.md that explains why this term is modeled this way."@en .

gng:nameVariant a owl:DatatypeProperty ;
    rdfs:label "name variant"@en ;
    rdfs:domain gng:Licensee ;
    rdfs:range xsd:string ;
    skos:definition "Another spelling of the licensee's name that appears in some document."@en ;
    gng:modelingDecision "MD9" .

gng:namesIdentifier a owl:DatatypeProperty ;
    rdfs:label "names identifier"@en ;
    rdfs:domain gng:LicenseNotice ;
    rdfs:range xsd:string ;
    skos:definition "A patent number, application serial, or case number that the notice names, including identifiers of patents that are not in the graph."@en .

gng:objectionDeadline a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "objection deadline"@en ;
    rdfs:domain gng:ProposedGrant ;
    rdfs:range xsd:date ;
    skos:definition "The last day on which NASA accepts objections. Until this day passes, rule R4 returns PENDING."@en ;
    gng:readByRule "R4" .

gng:objectionDeadlineBasis a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "objection deadline basis"@en ;
    rdfs:domain gng:ProposedGrant ;
    rdfs:range xsd:string ;
    skos:definition "How the deadline was found: a date the notice states, or the publication date plus a stated number of days."@en .

gng:patentNumber a owl:DatatypeProperty ;
    rdfs:label "patent number"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range xsd:string ;
    skos:definition "The United States patent number without punctuation. Absent while the patent has not issued."@en .

gng:permittedTerritory a owl:ObjectProperty ;
    rdfs:label "permitted territory"@en ;
    rdfs:domain gng:RestrictedExport ;
    rdfs:range gng:Territory ;
    skos:definition "A territory in which a licensee may sit when the technology is export-restricted."@en ;
    gng:readByRule "R5" .

gng:promptVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "prompt version"@en ;
    rdfs:domain gng:Extraction ;
    rdfs:range xsd:string ;
    skos:definition "The version of the instructions and output schema that a model extraction used, so a reader can find the exact prompt."@en ;
    gng:modelingDecision "MD14" .

gng:proposedBy a owl:ObjectProperty ;
    rdfs:label "proposed by"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range prov:Agent ;
    skos:definition "The person, organization, or software that put a candidate fact forward. A steward who proposed a fact cannot approve it."@en ;
    gng:modelingDecision "MD15" .

gng:publishedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "published on"@en ;
    rdfs:domain gng:ProposedGrant ;
    rdfs:range xsd:date ;
    skos:definition "The date the notice appeared in the Federal Register."@en .

gng:readByRule a owl:AnnotationProperty ;
    rdfs:label "read by rule"@en ;
    skos:definition "Names the clearance rule (R1 to R7) whose SPARQL template reads this term."@en .

gng:recordedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "recorded at"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range xsd:dateTime ;
    skos:definition "The moment the system recorded the fact. A rerun that uses a recording cutoff sees only facts recorded at or before the cutoff."@en ;
    gng:modelingDecision "MD7" ;
    gng:readByRule "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6" .

gng:registeredAddress a owl:DatatypeProperty ;
    rdfs:label "registered address"@en ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "The address as a document writes it."@en .

gng:reinstatedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reinstated on"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:date ;
    skos:definition "The date the registry accepted a late fee and revived a lapsed patent. Third parties may hold intervening rights for acts between the lapse date and this date."@en ;
    gng:readByRule "R1" .

gng:retrievedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "retrieved at"@en ;
    rdfs:domain gng:SourceDocument ;
    rdfs:range xsd:dateTime ;
    skos:definition "The moment the pipeline fetched the document."@en .

gng:royaltyOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "royalty of"@en ;
    rdfs:domain gng:RoyaltyTerm ;
    rdfs:range gng:ExecutedGrant ;
    skos:definition "The executed grant that a royalty term belongs to."@en .

gng:royaltyPercent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "royalty percent"@en ;
    rdfs:domain gng:RoyaltyTerm ;
    rdfs:range xsd:decimal ;
    skos:definition "The running royalty as a percentage of net sales."@en .

gng:secondApprovedBy a owl:ObjectProperty ;
    rdfs:label "second approved by"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    skos:definition "The counsel who made the second approval that a conflicting fact, or a fact that moves a verdict to GO, needs before it takes effect."@en ;
    gng:modelingDecision "MD15" .

gng:seededFrom a owl:ObjectProperty ;
    rdfs:label "seeded from"@en ;
    rdfs:domain gng:LicenseAgreement ;
    rdfs:range gng:LicenseNotice ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "Links a synthetic agreement to the real notice whose patents, exclusivity, field, and territory it copies."@en .

gng:sourceClause a owl:ObjectProperty ;
    rdfs:label "source clause"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range gng:Clause ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The clause that a fact was read from. A fact can point to several clauses."@en ;
    gng:modelingDecision "MD7" .

gng:spanEnd a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "span end"@en ;
    rdfs:domain gng:Clause ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Zero-based character offset where the clause ends, exclusive."@en .

gng:spanStart a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "span start"@en ;
    rdfs:domain gng:Clause ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Zero-based character offset where the clause begins in the document's full text."@en .

gng:spanText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "span text"@en ;
    rdfs:domain gng:Clause ;
    rdfs:range xsd:string ;
    skos:definition "The words in the span. A citation checker compares quoted text with this value."@en .

gng:statusText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "status text"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:string ;
    skos:definition "The status as the registry words it."@en .

gng:storedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "stored at"@en ;
    rdfs:domain gng:SourceDocument ;
    rdfs:range xsd:string ;
    skos:definition "The repository path of the stored copy of the document."@en .

gng:sublicenseAllowed a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sublicense allowed"@en ;
    rdfs:domain gng:ExecutedGrant ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the agreement lets the licensee grant sublicenses."@en .

gng:supersededAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "superseded at"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range xsd:dateTime ;
    skos:definition "The moment a correction replaced the fact. After a recording cutoff that falls on or after this moment, the fact no longer counts."@en ;
    gng:modelingDecision "MD7" .

gng:supersedes a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range gng:BitemporalFact ;
    owl:inverseOf gng:supersededBy ;
    skos:definition "A correction supersedes the fact it replaces. The replaced fact stays in the graph with a supersededAt time."@en ;
    gng:modelingDecision "MD7" .

gng:t2Category a owl:DatatypeProperty ;
    rdfs:label "T2 category"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range xsd:string ;
    skos:definition "The category that the NASA Technology Transfer portal assigns to the technology. The top level of the field-of-use scheme reuses these categories."@en .

gng:technologyReadinessLevel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "technology readiness level"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 9 ] ) ] ;
    skos:definition "The NASA technology readiness level, from 1 to 9, when the portal's description states one."@en .

gng:termAdjustmentDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "term adjustment (days)"@en ;
    rdfs:domain gng:PatentLegalStatus ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Days that the USPTO added to the 20-year term for its own delays."@en .

gng:topsId a owl:DatatypeProperty ;
    rdfs:label "TOPS identifier"@en ;
    rdfs:domain gng:Patent ;
    rdfs:range xsd:string ;
    skos:definition "The technology record identifier on the NASA Technology Transfer portal, for example LEW-TOPS-161."@en .

gng:validFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "valid from"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range xsd:date ;
    skos:definition "First day on which the fact holds in the world."@en ;
    gng:modelingDecision "MD7" ;
    gng:readByRule "R1",
        "R2",
        "R3" .

gng:validTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "valid to"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range xsd:date ;
    skos:definition "Last day on which the fact holds. Absent means the fact has no stated end."@en ;
    gng:modelingDecision "MD7" ;
    gng:readByRule "R1",
        "R2",
        "R3" .

<https://w3id.org/gonogo/ontology/external-terms> a owl:Ontology ;
    dct:title "External terms reused by the GoNoGo ontology"@en .

<https://w3id.org/gonogo/policy/bulk-load-v1> a prov:Agent,
        gng:ApprovalPolicy ;
    rdfs:label "Bulk-load policy v1"@en ;
    dct:description "Standing approval for public system-of-record data (NASA Patents dataset, USPTO Open Data Portal, Federal Register notices read by the deterministic extractor). It never approves a fact that a language model extracted."@en .

<https://w3id.org/gonogo/policy/synthetic-load-v1> a prov:Agent,
        gng:ApprovalPolicy ;
    rdfs:label "Synthetic-load policy v1"@en ;
    dct:description "Standing approval to load labeled synthetic evaluation data from the seeded generator."@en .

skos:broaderTransitive a owl:ObjectProperty,
        owl:TransitiveProperty ;
    owl:inverseOf skos:narrowerTransitive .

skos:narrower a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:narrowerTransitive .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:inScheme .

excl:co-exclusive a skos:Concept,
        gng:ExclusivityType ;
    skos:definition "A fixed, small number of licensees share the rights, and the agreements state the cap."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/exclusivity> ;
    skos:notation "co-exclusive" ;
    skos:prefLabel "co-exclusive"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/exclusivity> .

excl:exclusive a skos:Concept,
        gng:ExclusivityType ;
    skos:definition "One licensee holds the rights in the field and territory, and NASA grants no other license there."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/exclusivity> ;
    skos:notation "exclusive" ;
    skos:prefLabel "exclusive"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/exclusivity> .

excl:non-exclusive a skos:Concept,
        gng:ExclusivityType ;
    skos:definition "Any number of licensees may hold the rights. NASA can grant more licenses at any time."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/exclusivity> ;
    skos:notation "non-exclusive" ;
    skos:prefLabel "non-exclusive"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/exclusivity> .

excl:partially-exclusive a skos:Concept,
        gng:ExclusivityType ;
    skos:definition "One licensee holds exclusive rights in a narrowed field or territory, and NASA may license the rest."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/exclusivity> ;
    skos:notation "partially-exclusive" ;
    skos:prefLabel "partially exclusive"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/exclusivity> .

state:abandoned a skos:Concept,
        gng:LegalState ;
    skos:definition "The application was abandoned before a patent issued."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "abandoned" ;
    skos:prefLabel "abandoned"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

state:application a skos:Concept,
        gng:LegalState ;
    skos:definition "The NASA Patents snapshot lists the record as an application. The snapshot is old, so this state is weaker evidence than a USPTO state."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "application" ;
    skos:prefLabel "application"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

state:in-force a skos:Concept,
        gng:LegalState ;
    skos:definition "The patent was granted, no maintenance-fee lapse stands, and its term has not ended."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "in_force" ;
    skos:prefLabel "in force"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

state:lapsed a skos:Concept,
        gng:LegalState ;
    skos:definition "The patent expired early because the owner did not pay a maintenance fee, and no late payment reinstated it."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "lapsed" ;
    skos:prefLabel "lapsed"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

state:not-granted a skos:Concept,
        gng:LegalState ;
    skos:definition "No patent has issued and the registry reports no abandonment."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "not_granted" ;
    skos:prefLabel "not granted"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

state:term-ended a skos:Concept,
        gng:LegalState ;
    skos:definition "The statutory term ran out: earliest filing date plus 20 years plus any term adjustment."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/legal-state> ;
    skos:notation "term_ended" ;
    skos:prefLabel "term ended"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/legal-state> .

gng:ApproveFact a owl:Class ;
    rdfs:label "Approve fact"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:ApproveFact,
        gng:FactGeneration ;
    skos:definition "A steward promotes a candidate fact to the approved graph and records the reason."@en .

gng:BulkLoad a owl:Class ;
    rdfs:label "Bulk load"@en ;
    rdfs:subClassOf prov:Activity,
        gng:BulkLoad,
        gng:FactGeneration ;
    skos:definition "A run that loaded system-of-record data from a public registry or dataset under a standing approval policy."@en .

gng:ClearanceRequest a owl:Class ;
    rdfs:label "Clearance request"@en ;
    rdfs:subClassOf prov:Entity,
        gng:ClearanceRequest ;
    skos:definition "A structured request for a verdict: patent, licensee, field of use, territory, term, and exclusivity type. Gate 2 adds its properties."@en .

gng:CorrectFact a owl:Class ;
    rdfs:label "Correct fact"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:CorrectFact,
        gng:FactGeneration ;
    skos:definition "A steward supersedes an approved fact with a new one. The original stays in the graph."@en .

gng:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    rdfs:subClassOf prov:Entity,
        gng:Decision ;
    skos:definition "The stored result of one clearance request: the rule findings, the combiner policy, the release, the recording cutoff, and the verdict. Gate 2 adds its properties."@en .

gng:Generator a owl:Class ;
    rdfs:label "Generator"@en ;
    rdfs:subClassOf prov:Agent,
        prov:SoftwareAgent,
        gng:Generator ;
    skos:definition "The synthetic-data generator, as a software agent."@en .

gng:LinkIdentity a owl:Class ;
    rdfs:label "Link identity"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:FactGeneration,
        gng:LinkIdentity ;
    skos:definition "A steward approves a proposed identity link between two party nodes."@en .

gng:ModelAgent a owl:Class ;
    rdfs:label "Model agent"@en ;
    rdfs:subClassOf prov:Agent,
        prov:SoftwareAgent,
        gng:ModelAgent ;
    skos:definition "A language model, identified by its model ID, as the software agent that proposed a fact. A model agent cannot approve anything."@en ;
    gng:modelingDecision "MD15" .

gng:OverrideVerdict a owl:Class ;
    rdfs:label "Override verdict"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:OverrideVerdict ;
    skos:definition "Counsel records a different outcome with a written justification. The original decision stays unchanged."@en .

gng:ProposeFacts a owl:Class ;
    rdfs:label "Propose facts"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:FactGeneration,
        gng:ProposeFacts ;
    skos:definition "The ingestion pipeline writes candidate facts to the candidate graph."@en .

gng:PublishRelease a owl:Class ;
    rdfs:label "Publish release"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:PublishRelease ;
    skos:definition "The ontology owner activates a release bundle after the release gate passes."@en .

gng:RejectFact a owl:Class ;
    rdfs:label "Reject fact"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:RejectFact ;
    skos:definition "A steward discards a candidate fact and records the reason."@en .

gng:SecondReview a owl:Class ;
    rdfs:label "Second review"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:SecondReview ;
    skos:definition "Counsel approves or denies a steward's submitted approval. Counsel is never the proposer or the first approver."@en ;
    gng:modelingDecision "MD15" .

gng:Steward a owl:Class ;
    rdfs:label "Steward"@en ;
    rdfs:subClassOf prov:Agent,
        prov:Person,
        gng:Steward ;
    skos:definition "A person who approves, edits, rejects, or corrects facts."@en .

gng:SubmitClearanceRequest a owl:Class ;
    rdfs:label "Submit clearance request"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:SubmitClearanceRequest ;
    skos:definition "A licensing manager asks for a verdict."@en .

gng:SubmitForSecondReview a owl:Class ;
    rdfs:label "Submit for second review"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action,
        gng:SubmitForSecondReview ;
    skos:definition "A steward's approval that conflicts with an approved fact, or that would move a verdict from COUNSEL or NO GO to GO, waits for counsel. The submission changes no fact."@en ;
    gng:modelingDecision "MD15" .

gng:aboutPatent a owl:ObjectProperty ;
    rdfs:label "about patent"@en ;
    rdfs:domain gng:BitemporalFact ;
    rdfs:range gng:Patent ;
    skos:definition "Relates a fact to a patent that it describes. A grant can cover several patents."@en ;
    gng:readByRule "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6" .

gng:coversField a owl:ObjectProperty ;
    rdfs:label "covers field"@en ;
    rdfs:comment "This property chain is the formal statement of the rule that broader means wider rights. The pipeline materializes it before load because Neptune does not reason at query time."@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:FieldOfUse ;
    owl:propertyChainAxiom ( gng:fieldOfUse skos:narrowerTransitive ) ;
    skos:definition "Relates a grant to every field its rights reach: the named field and every narrower field beneath it. A reasoner derives this property from skos:narrower, so the hierarchy decides coverage."@en ;
    gng:modelingDecision "MD13",
        "MD4" ;
    gng:readByRule "R2" .

gng:coversTerritory a owl:ObjectProperty ;
    rdfs:label "covers territory"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:Territory ;
    owl:propertyChainAxiom ( gng:territory skos:narrowerTransitive ) ;
    skos:definition "Relates a grant to every territory its rights reach: the named territory and every country beneath it."@en ;
    gng:modelingDecision "MD13",
        "MD4" ;
    gng:readByRule "R2" .

gng:exclusivityType a owl:ObjectProperty ;
    rdfs:label "exclusivity type"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:ExclusivityType ;
    skos:definition "How exclusive the grant is. An executed grant has exactly one. A proposed grant from a notice that offers several types has several."@en ;
    gng:readByRule "R2",
        "R3",
        "R4",
        "R7" .

gng:licensee a owl:ObjectProperty ;
    rdfs:label "licensee"@en ;
    rdfs:domain gng:Grant ;
    rdfs:range gng:Licensee ;
    skos:definition "The party that holds or asks for the grant."@en ;
    gng:readByRule "R2",
        "R3" .

gng:supersededBy a owl:ObjectProperty ;
    rdfs:label "superseded by"@en ;
    skos:definition "Inverse of supersedes."@en .

prov:Person a owl:Class ;
    rdfs:subClassOf prov:Agent,
        prov:Person .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent .

