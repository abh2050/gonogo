    skos:definition "NASA T2 portal category Instrumentation."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:nondestructive-evaluation,
        field:test-and-measurement ;
    skos:narrowerTransitive field:nondestructive-evaluation,
        field:test-and-measurement ;
    skos:notation "07" ;
    skos:prefLabel "Instrumentation"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:manufacturing a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Manufacturing."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:additive-manufacturing,
        field:joining-and-welding ;
    skos:narrowerTransitive field:additive-manufacturing,
        field:joining-and-welding ;
    skos:notation "08" ;
    skos:prefLabel "Manufacturing"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:optics a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Optics."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:lasers,
        field:lenses-and-mirrors ;
    skos:narrowerTransitive field:lasers,
        field:lenses-and-mirrors ;
    skos:notation "11" ;
    skos:prefLabel "Optics"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:power-generation-and-storage a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Power Generation and Storage."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:batteries,
        field:energy-generation ;
    skos:narrowerTransitive field:batteries,
