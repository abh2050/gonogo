    skos:prefLabel "Power Generation and Storage"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:propulsion a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Propulsion."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:electric-propulsion,
        field:rocket-propulsion ;
    skos:narrowerTransitive field:electric-propulsion,
        field:rocket-propulsion ;
    skos:notation "13" ;
    skos:prefLabel "Propulsion"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:robotics-automation-and-control a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Robotics, Automation, and Control."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:control-systems,
        field:robotics ;
    skos:narrowerTransitive field:control-systems,
        field:robotics ;
    skos:notation "14" ;
    skos:prefLabel "Robotics, Automation, and Control"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

gng:IdentityLink a owl:Class ;
    rdfs:label "Identity link"@en ;
    rdfs:comment "A rule must never merge two companies on a guess. A link is a decision, so it carries provenance like any other fact."@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:IdentityLink ;
    skos:definition "A steward-approved statement that two party nodes name the same organization. Approval writes an owl:sameAs statement and this node, which records the match score, the method, who approved the link, and when."@en ;
    gng:modelingDecision "MD9" ;
    gng:readByRule "R4" .

gng:LicenseNotice a owl:Class ;
    rdfs:label "License notice"@en ;
    rdfs:subClassOf prov:Entity,
        gng:LicenseNotice,
        gng:SourceDocument ;
    skos:definition "A Federal Register notice of NASA's intent to grant a patent license. A notice announces a proposed grant and opens an objection window. It never proves that a license exists."@en ;
    gng:modelingDecision "MD2" ;
    gng:readByRule "R4" .

gng:RoyaltyTerm a owl:Class ;
    rdfs:label "Royalty term"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:RoyaltyTerm ;
    skos:definition "The confidential royalty terms of an executed grant. Royalty terms live in their own named graph, so graph-level access control can hide them from licensing managers."@en ;
    gng:modelingDecision "MD11" .

territory:MIDDLE-EAST a skos:Concept,
