    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:damping-and-vibration,
        field:tires-and-wheels,
        field:valves-and-pumps ;
    skos:narrowerTransitive field:damping-and-vibration,
        field:tires-and-wheels,
        field:valves-and-pumps ;
    skos:notation "10" ;
    skos:prefLabel "Mechanical and Fluid Systems"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:sensors a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Sensors."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:chemical-sensors,
        field:magnetic-field-sensors,
        field:structural-health-sensors ;
    skos:narrowerTransitive field:chemical-sensors,
        field:magnetic-field-sensors,
        field:structural-health-sensors ;
    skos:notation "15" ;
    skos:prefLabel "Sensors"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

gng:Clause a owl:Class ;
    rdfs:label "Clause"@en ;
    rdfs:subClassOf prov:Entity,
        gng:Clause ;
    skos:definition "A character span inside a source document. A clause is the evidence that a fact points to, so a reader can open the document at the exact words."@en ;
    gng:modelingDecision "MD7" .

gng:ExecutedGrant a owl:Class ;
    rdfs:label "Executed grant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gng:licensee ;
            owl:someValuesFrom gng:Licensee ],
        [ a owl:Restriction ;
            owl:onProperty gng:aboutPatent ;
            owl:someValuesFrom gng:Patent ],
        [ a owl:Restriction ;
            owl:onProperty gng:fieldOfUse ;
            owl:someValuesFrom gng:FieldOfUse ],
        [ a owl:Restriction ;
            owl:onProperty gng:territory ;
            owl:someValuesFrom gng:Territory ],
        [ a owl:Restriction ;
            owl:onClass gng:ExclusivityType ;
            owl:onProperty gng:exclusivityType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        prov:Entity,
        gng:BitemporalFact,
        gng:ExecutedGrant,
        gng:Grant ;
    owl:disjointWith gng:ProposedGrant ;
    skos:definition "A grant that a signed agreement creates. It states one exclusivity type, a field of use, a territory, and a term."@en ;
    gng:modelingDecision "MD2" ;
    gng:readByRule "R2",
        "R3" .

skos:ConceptScheme a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme .

gng:ExclusivityType a owl:Class ;
    rdfs:label "Exclusivity type"@en ;
    rdfs:subClassOf skos:Concept,
        gng:ExclusivityType ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/gonogo/scheme/exclusivity> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    skos:definition "A concept in the exclusivity scheme: exclusive, partially exclusive, co-exclusive, or non-exclusive."@en ;
    gng:readByRule "R2",
        "R3",
        "R4",
        "R7" .

gng:FactGeneration a owl:Class ;
    rdfs:label "Fact generation"@en ;
    rdfs:subClassOf prov:Activity,
        gng:FactGeneration ;
    skos:definition "An activity that produced facts: a bulk load of registry data, an extraction from a document, or a run of the synthetic generator."@en ;
    gng:modelingDecision "MD8" .

gng:SourceDocument a owl:Class ;
    rdfs:label "Source document"@en ;
    rdfs:subClassOf prov:Entity,
        gng:SourceDocument ;
    skos:definition "A document or registry record from which a fact was read."@en .

territory:NORTH-AMERICA a skos:Concept,
        gng:Territory ;
    skos:broader territory:WORLD ;
    skos:broaderTransitive territory:WORLD ;
    skos:inScheme <https://w3id.org/gonogo/scheme/territory> ;
    skos:narrower territory:CA,
        territory:MX,
        territory:US ;
    skos:narrowerTransitive territory:CA,
        territory:MX,
        territory:US ;
    skos:notation "NORTH-AMERICA" ;
    skos:prefLabel "North America"@en .

field:materials-and-coatings a skos:Concept,
        gng:FieldOfUse ;
    skos:definition "NASA T2 portal category Materials and Coatings."@en ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:narrower field:aerogels,
        field:alloys,
        field:coatings,
        field:polymers-and-composites ;
    skos:narrowerTransitive field:aerogels,
        field:alloys,
        field:coatings,
        field:polymers-and-composites ;
    skos:notation "09" ;
    skos:prefLabel "Materials and Coatings"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

gng:LegalState a owl:Class ;
    rdfs:label "Legal state"@en ;
    rdfs:subClassOf skos:Concept,
        gng:LegalState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/gonogo/scheme/legal-state> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    skos:definition "A concept in the legal-state scheme: in force, lapsed, term ended, abandoned, not granted, or application."@en ;
    gng:readByRule "R1" .

gng:ProposedGrant a owl:Class ;
    rdfs:label "Proposed grant"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:Grant,
        gng:ProposedGrant ;
    skos:definition "A grant that a license notice announces. It records intent. The objection window can end without a license."@en ;
    gng:modelingDecision "MD2" ;
    gng:readByRule "R2",
        "R4" .

<https://w3id.org/gonogo/scheme/exclusivity> a skos:ConceptScheme ;
    dct:description "How exclusive a license is. The scheme is flat on purpose."@en ;
    dct:title "GoNoGo exclusivity-type scheme"@en ;
    skos:hasTopConcept excl:co-exclusive,
        excl:exclusive,
        excl:non-exclusive,
        excl:partially-exclusive .

gng:Patent a owl:Class ;
    rdfs:label "Patent"@en ;
    rdfs:comment "Keeping status out of the Patent node lets two sources disagree about the same patent without overwriting each other, and lets a later fact supersede an earlier one."@en ;
    rdfs:subClassOf gng:Patent ;
    skos:definition "A United States patent or patent application that NASA owns, alone or jointly. The class holds identity only. Legal status, ownership, and licenses are separate facts about the patent."@en ;
    gng:modelingDecision "MD1" .

gng:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:subClassOf prov:Activity,
        gng:Action ;
    skos:definition "A governed state change. Each action has typed inputs, a permission check, a validation step, a target named graph, and a queryable provenance record."@en ;
    gng:modelingDecision "MD12" .

gng:Grant a owl:Class ;
    rdfs:label "Grant"@en ;
    rdfs:comment "Modeled as a class, in the pattern of the W3C note on n-ary relations, because a binary property cannot carry six participants."@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:Grant ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( gng:ProposedGrant gng:ExecutedGrant ) ] ;
    skos:definition "A license that relates a patent, a licensee, a field of use, a territory, a term, and an exclusivity type at once. The class is abstract: every grant is either proposed or executed."@en ;
    gng:modelingDecision "MD1",
        "MD2" ;
    gng:readByRule "R2",
        "R3" .

gng:PatentLegalStatus a owl:Class ;
    rdfs:label "Patent legal status"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:PatentLegalStatus ;
    skos:definition "What a registry reports about whether a patent is alive: its legal state, its expiration date, and how that date was found. Two registries can each report a status for the same patent."@en ;
    gng:modelingDecision "MD1",
        "MD10" ;
    gng:readByRule "R1" .

<https://w3id.org/gonogo/scheme/legal-state> a skos:ConceptScheme ;
    dct:description "The legal state of a patent or application, as a registry reports it."@en ;
    dct:title "GoNoGo patent legal-state scheme"@en ;
    skos:hasTopConcept state:abandoned,
        state:application,
        state:in-force,
        state:lapsed,
        state:not-granted,
        state:term-ended .

prov:Agent a owl:Class ;
    rdfs:subClassOf prov:Agent .

gng:NASACenter a owl:Class ;
    rdfs:label "NASA center"@en ;
    rdfs:subClassOf gng:NASACenter ;
    skos:definition "A NASA field center or headquarters that holds patents."@en .

territory:ASIA-PACIFIC a skos:Concept,
        gng:Territory ;
    skos:broader territory:WORLD ;
    skos:broaderTransitive territory:WORLD ;
    skos:inScheme <https://w3id.org/gonogo/scheme/territory> ;
    skos:narrower territory:AU,
        territory:CN,
        territory:IN,
        territory:JP,
        territory:KR,
        territory:SG ;
    skos:narrowerTransitive territory:AU,
        territory:CN,
        territory:IN,
        territory:JP,
        territory:KR,
        territory:SG ;
    skos:notation "ASIA-PACIFIC" ;
    skos:prefLabel "Asia Pacific"@en .

territory:EUROPE a skos:Concept,
        gng:Territory ;
    skos:broader territory:WORLD ;
    skos:broaderTransitive territory:WORLD ;
    skos:inScheme <https://w3id.org/gonogo/scheme/territory> ;
    skos:narrower territory:DE,
        territory:FR,
        territory:GB,
        territory:IT,
        territory:NL,
        territory:SE ;
    skos:narrowerTransitive territory:DE,
        territory:FR,
        territory:GB,
        territory:IT,
        territory:NL,
        territory:SE ;
    skos:notation "EUROPE" ;
    skos:prefLabel "Europe"@en .

prov:Activity a owl:Class ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/gonogo/scheme/territory> a skos:ConceptScheme ;
    dct:description "Territories that a license can name: the world, commercial regions, and ISO 3166 countries."@en ;
    dct:source <https://www.iso.org/iso-3166-country-codes.html> ;
    dct:title "GoNoGo territory scheme"@en ;
    skos:hasTopConcept territory:WORLD .

gng:BitemporalFact a owl:Class ;
    rdfs:label "Bitemporal fact"@en ;
    rdfs:comment "Valid time answers whether a grant applies on a date. Recording time answers what the system knew when it decided. Reproducing a past verdict needs both."@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact ;
    skos:definition "A statement that the system records with two times: the valid time, when the statement holds in the world, and the recording time, when the system learned it. A correction supersedes a fact and never deletes it."@en ;
    gng:modelingDecision "MD7" .

territory:WORLD a skos:Concept,
        gng:Territory ;
    skos:inScheme <https://w3id.org/gonogo/scheme/territory> ;
    skos:narrower territory:ASIA-PACIFIC,
        territory:EUROPE,
        territory:MIDDLE-EAST,
        territory:NORTH-AMERICA ;
    skos:narrowerTransitive territory:AE,
        territory:ASIA-PACIFIC,
        territory:AU,
        territory:CA,
        territory:CN,
        territory:DE,
        territory:EUROPE,
        territory:FR,
        territory:GB,
        territory:IL,
        territory:IN,
        territory:IT,
        territory:JP,
        territory:KR,
        territory:MIDDLE-EAST,
        territory:MX,
        territory:NL,
        territory:NORTH-AMERICA,
        territory:SE,
        territory:SG,
        territory:US ;
    skos:notation "WORLD" ;
    skos:prefLabel "Worldwide"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/territory> .

prov:Entity a owl:Class ;
    rdfs:subClassOf prov:Entity .

gng:Territory a owl:Class ;
    rdfs:label "Territory"@en ;
    rdfs:subClassOf skos:Concept,
        gng:Territory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/gonogo/scheme/territory> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    skos:definition "A concept in the territory scheme: the world, a commercial region, or a country with an ISO 3166-1 alpha-2 code."@en ;
    gng:modelingDecision "MD3",
        "MD4" ;
    gng:readByRule "R2",
        "R5" .

gng:FieldOfUse a owl:Class ;
    rdfs:label "Field of use"@en ;
    rdfs:comment "Fields of use are SKOS concepts, not OWL subclasses. Subclassing would assert that every instance of a narrow field is an instance of the broad field, which is a claim about sets that the business does not make. The business edits this hierarchy as a policy."@en ;
    rdfs:subClassOf skos:Concept,
        gng:FieldOfUse ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/gonogo/scheme/field-of-use> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    skos:definition "A concept in the field-of-use scheme. Broader means wider rights coverage."@en ;
    gng:modelingDecision "MD3",
        "MD4" ;
    gng:readByRule "R2" .

<https://w3id.org/gonogo/scheme/field-of-use> a skos:ConceptScheme ;
    dct:description "Fields of use that a license can name. Broader means wider rights coverage, not logical subclassing."@en ;
    dct:source <https://technology.nasa.gov/> ;
    dct:title "GoNoGo field-of-use scheme"@en ;
    skos:hasTopConcept field:aerospace,
        field:communications,
        field:electrical-and-electronics,
        field:environment,
        field:health-medicine-and-biotechnology,
        field:information-technology-and-software,
        field:instrumentation,
        field:manufacturing,
        field:materials-and-coatings,
        field:mechanical-and-fluid-systems,
        field:optics,
        field:power-generation-and-storage,
        field:propulsion,
        field:robotics-automation-and-control,
        field:sensors .

skos:Concept a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    owl:disjointWith skos:ConceptScheme .

[] a owl:AllDisjointClasses ;
    owl:members ( gng:Grant gng:OwnershipRecord gng:ConsentRecord gng:ExportClassification gng:PatentLegalStatus gng:FilingRecord gng:RoyaltyTerm gng:IdentityLink gng:FieldOfUseAssignment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( gng:LicenseNotice gng:LicenseAgreement gng:RegistryRecord ) .

[] a owl:AllDisjointClasses ;
    owl:members ( gng:FieldOfUse gng:Territory gng:ExclusivityType gng:LegalState ) .

