    skos:narrower field:optical-communications,
        field:rf-antennas ;
    skos:narrowerTransitive field:optical-communications,
        field:rf-antennas ;
    skos:notation "02" ;
    skos:prefLabel "Communications"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:electrical-and-electronics a skos:Concept,
