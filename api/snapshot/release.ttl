skos:narrowerTransitive a owl:ObjectProperty,
        owl:TransitiveProperty .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

gng:ConsentRecord a owl:Class ;
    rdfs:label "Consent record"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:ConsentRecord ;
    skos:definition "A co-owner's consent to license the patent."@en ;
    gng:readByRule "R6" .

gng:ExportClassification a owl:Class ;
    rdfs:label "Export classification"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:ExportClassification ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( gng:RestrictedExport gng:UnrestrictedExport ) ] ;
    skos:definition "The export-control status of the technology a patent covers. The class is abstract: a classification is either restricted or unrestricted."@en ;
    gng:readByRule "R5" .

gng:FieldOfUseAssignment a owl:Class ;
    rdfs:label "Field of use assignment"@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:FieldOfUseAssignment ;
    skos:definition "A statement that a proposed grant covers one field of use, read from the words of its notice. A notice often says only that the field may be limited. A model proposes the assignment, and it counts only after a steward approves it."@en ;
    gng:modelingDecision "MD14" ;
    gng:readByRule "R2" .

gng:LicenseAgreement a owl:Class ;
    rdfs:label "License agreement"@en ;
    rdfs:subClassOf prov:Entity,
        gng:LicenseAgreement,
        gng:SourceDocument ;
    skos:definition "A signed patent license agreement. Only an agreement creates an executed grant."@en ;
    gng:modelingDecision "MD2" .

gng:Licensee a owl:Class ;
    rdfs:label "Licensee"@en ;
    rdfs:subClassOf schema:Organization,
        gng:Licensee ;
    skos:definition "An organization that holds, or asks for, a license. Different documents name the same licensee in different ways, so each spelling can be a separate node until a steward links them with owl:sameAs."@en ;
    gng:modelingDecision "MD9" .

gng:OwnershipRecord a owl:Class ;
    rdfs:label "Ownership record"@en ;
    rdfs:comment "Without this record, the absence of co-owners proves nothing under the open world assumption."@en ;
    rdfs:subClassOf prov:Entity,
        gng:BitemporalFact,
        gng:OwnershipRecord ;
    skos:definition "A statement about who co-owns a patent. The record says whether its co-owner list is exhaustive. An exhaustive list with no entries is an explicit negative fact: the patent has no co-owners."@en ;
    gng:modelingDecision "MD5",
        "MD6" ;
    gng:readByRule "R6" .

skos:inScheme a owl:ObjectProperty ;
    rdfs:range skos:ConceptScheme .

field:communications a skos:Concept,
