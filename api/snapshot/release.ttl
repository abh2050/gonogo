    skos:narrower field:power-electronics,
        field:wiring-and-insulation ;
    skos:narrowerTransitive field:power-electronics,
        field:wiring-and-insulation ;
    skos:notation "03" ;
    skos:prefLabel "Electrical and Electronics"@en ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> .

field:environment a skos:Concept,
