# R5. The export classification of the patent and, when it is restricted, the territories that a licensee may sit in.
SELECT ?export ?kind ?code ?recorded
{{FROM}}
WHERE {
  ?export a ?class ; gng:aboutPatent {{patent}} ; gng:recordedAt ?recorded .
  VALUES (?class ?kind) { (gng:RestrictedExport "restricted") (gng:UnrestrictedExport "unrestricted") }
  {{ASOF ?export}}
  OPTIONAL { ?export gng:permittedTerritory/gng:iso3166Alpha2 ?code }
}
ORDER BY DESC(?recorded)
