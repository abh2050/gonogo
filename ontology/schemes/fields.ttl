@prefix gng:     <https://w3id.org/gonogo/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix field:   <https://w3id.org/gonogo/field/> .

# Field-of-use scheme
#
# Rights coverage rule: a grant for a broader field covers every narrower field beneath it, and a
# request for a broader field overlaps every grant on a narrower field. Every edit to skos:broader
# in this file therefore changes legal outcomes, and the release pipeline reports each changed verdict
# before it publishes a new release (docs/modeling-decisions.md, decision 4).
#
# Top concepts are the NASA Technology Transfer portal (T2) categories. The narrower concepts are
# GoNoGo's own refinement. skos:notation orders siblings and is stable across edits.

<https://w3id.org/gonogo/scheme/field-of-use> a skos:ConceptScheme ;
    dct:title "GoNoGo field-of-use scheme"@en ;
    dct:description "Fields of use that a license can name. Broader means wider rights coverage, not logical subclassing."@en ;
    dct:source <https://technology.nasa.gov/> ;
    skos:hasTopConcept field:aerospace, field:communications, field:electrical-and-electronics, field:environment, field:health-medicine-and-biotechnology, field:information-technology-and-software, field:instrumentation, field:manufacturing, field:materials-and-coatings, field:mechanical-and-fluid-systems, field:optics, field:power-generation-and-storage, field:propulsion, field:robotics-automation-and-control, field:sensors .

field:aerospace a skos:Concept ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:topConceptOf <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:prefLabel "Aerospace"@en ;
    skos:notation "01" ;
    skos:definition "NASA T2 portal category Aerospace."@en ;
    skos:narrower field:aircraft-structures, field:spacecraft-systems, field:unmanned-aircraft .
field:aircraft-structures a skos:Concept ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:broader field:aerospace ;
    skos:prefLabel "Aircraft structures"@en ;
    skos:notation "01.01" .
field:spacecraft-systems a skos:Concept ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:broader field:aerospace ;
    skos:prefLabel "Spacecraft systems"@en ;
    skos:notation "01.02" .
field:unmanned-aircraft a skos:Concept ;
    skos:inScheme <https://w3id.org/gonogo/scheme/field-of-use> ;
    skos:broader field:aerospace ;
    skos:prefLabel "Unmanned aircraft"@en ;
    skos:notation "01.03" .

