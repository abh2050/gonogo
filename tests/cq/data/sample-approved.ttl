    gng:aboutPatent ex:P1 , ex:P4 ; gng:licensee ex:LicD ; gng:exclusivityType excl:exclusive ;
    gng:fieldOfUseText "laser welding" ; gng:fieldOfUseStatus "stated" ; gng:territory territory:US ;
