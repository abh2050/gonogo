ex:P2 a gng:Patent ; gng:caseNumber "TST-10002-1" ; dct:title "Sample patent two" ; gng:center <https://w3id.org/gonogo/center/LaRC> .
ex:P3 a gng:Patent ; gng:caseNumber "TST-10003-1" ; dct:title "Sample patent three" ; gng:center <https://w3id.org/gonogo/center/GRC> .
ex:P4 a gng:Patent ; gng:caseNumber "TST-10004-1" ; dct:title "Sample patent four" ; gng:center <https://w3id.org/gonogo/center/GRC> .
ex:P5 a gng:Patent ; gng:caseNumber "TST-10005-1" ; dct:title "Sample patent five" ; gng:center <https://w3id.org/gonogo/center/KSC> .
ex:P6 a gng:Patent ; gng:caseNumber "TST-10006-1" ; dct:title "Sample patent six" ; gng:center <https://w3id.org/gonogo/center/KSC> .
ex:P7 a gng:Patent ; gng:caseNumber "TST-10007-1" ; dct:title "Sample patent seven" ; gng:center <https://w3id.org/gonogo/center/KSC> .
ex:P8 a gng:Patent ; gng:caseNumber "TST-10008-1" ; dct:title "Sample patent eight" ; gng:center <https://w3id.org/gonogo/center/LaRC> .

# ----- Legal status ---------------------------------------------------------------------------------

ex:regUSPTO1 a gng:RegistryRecord .
ex:regUSPTO2 a gng:RegistryRecord .
ex:regNASA a gng:RegistryRecord .

ex:status-P1-uspto a gng:PatentLegalStatus ;
    gng:aboutPatent ex:P1 ; gng:legalState state:in-force ; gng:statusText "Patented Case" ;
    gng:expirationDate "2036-05-02"^^xsd:date ; gng:expirationBasis "earliest filing + 20 years + PTA" ;
    gng:expirationIsDerived true ;
    gng:validFrom "2011-12-13"^^xsd:date ; gng:recordedAt "2026-10-24T18:00:00Z"^^xsd:dateTime ;
    prov:wasDerivedFrom ex:regUSPTO1 ; prov:wasGeneratedBy ex:runBulk ; gng:approvedBy policy:bulk-load-v1 .

ex:status-P2-uspto a gng:PatentLegalStatus ;
    gng:aboutPatent ex:P2 ; gng:legalState state:lapsed ; gng:statusText "Patent Expired Due to NonPayment of Maintenance Fees" ;
    gng:lapseDate "2019-12-13"^^xsd:date ;
    gng:expirationDate "2030-09-10"^^xsd:date ; gng:expirationBasis "earliest filing + 20 years + PTA" ;
    gng:expirationIsDerived true ;
    gng:validFrom "2019-12-13"^^xsd:date ; gng:recordedAt "2026-10-24T18:00:00Z"^^xsd:dateTime ;
    prov:wasDerivedFrom ex:regUSPTO2 ; prov:wasGeneratedBy ex:runBulk ; gng:approvedBy policy:bulk-load-v1 .

ex:status-P2-nasa a gng:PatentLegalStatus ;
    gng:aboutPatent ex:P2 ; gng:statusText "Issued" ;
    gng:expirationDate "2027-07-06"^^xsd:date ; gng:expirationBasis "NASA Patents dataset nominal expiration date" ;
    gng:expirationIsDerived false ;
    gng:validFrom "2025-05-29"^^xsd:date ; gng:recordedAt "2026-10-24T17:48:00Z"^^xsd:dateTime ;
    prov:wasDerivedFrom ex:regNASA ; prov:wasGeneratedBy ex:runBulk ; gng:approvedBy policy:bulk-load-v1 .

ex:status-P3-nasa a gng:PatentLegalStatus ;
    gng:aboutPatent ex:P3 ; gng:statusText "Issued" ;
    gng:validFrom "2025-05-29"^^xsd:date ; gng:recordedAt "2026-10-24T17:48:00Z"^^xsd:dateTime ;
    prov:wasDerivedFrom ex:regNASA ; prov:wasGeneratedBy ex:runBulk ; gng:approvedBy policy:bulk-load-v1 .

ex:filing-P3 a gng:FilingRecord ;
    gng:aboutPatent ex:P3 ; gng:filingDate "2016-05-02"^^xsd:date ;
    gng:validFrom "2016-05-02"^^xsd:date ; gng:recordedAt "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    prov:wasGeneratedBy <https://w3id.org/gonogo/synth/generator/v0.1> ; gng:approvedBy policy:synthetic-load-v1 .

# ----- Grants on P1 ---------------------------------------------------------------------------------

ex:LicA a gng:Licensee ; <https://schema.org/legalName> "Alpha Optics, Inc." .
ex:LicB a gng:Licensee ; <https://schema.org/legalName> "Beta Photonics, LLC" .
ex:LicC a gng:Licensee ; <https://schema.org/legalName> "Gamma Lasers Ltd." .
ex:LicD a gng:Licensee ; <https://schema.org/legalName> "Delta Welding Co." .

ex:agreement-G1 a gng:LicenseAgreement ; dct:identifier "G1" .
ex:clause-G1-grant a gng:Clause ; gng:inDocument ex:agreement-G1 ; gng:clauseKind "grant" ;
    gng:spanStart 100 ; gng:spanEnd 190 ; gng:spanText "NASA grants Licensee an exclusive license under the Licensed Patents." ;
    prov:wasGeneratedBy <https://w3id.org/gonogo/synth/generator/v0.1> .
ex:clause-G1-term a gng:Clause ; gng:inDocument ex:agreement-G1 ; gng:clauseKind "term" ;
    gng:spanStart 300 ; gng:spanEnd 380 ; gng:spanText "This Agreement takes effect on January 1, 2025." ;
    prov:wasGeneratedBy <https://w3id.org/gonogo/synth/generator/v0.1> .

ex:G1 a gng:ExecutedGrant ;
    gng:aboutPatent ex:P1 ; gng:licensee ex:LicA ; gng:exclusivityType excl:exclusive ;
    gng:fieldOfUse field:optics ; gng:territory territory:NORTH-AMERICA ;
    gng:validFrom "2025-01-01"^^xsd:date ; gng:validTo "2034-12-31"^^xsd:date ;
    gng:executedOn "2024-12-15"^^xsd:date ; gng:recordedAt "2025-01-10T00:00:00Z"^^xsd:dateTime ;
    gng:executedUnder ex:agreement-G1 ; gng:sourceClause ex:clause-G1-grant , ex:clause-G1-term ;
    prov:wasGeneratedBy <https://w3id.org/gonogo/synth/generator/v0.1> ; gng:approvedBy policy:synthetic-load-v1 .

